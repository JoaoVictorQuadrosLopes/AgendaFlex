PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=verify-full
JWT_SECRET=troque_este_secret_por_um_valor_com_32_caracteres_ou_mais

# Frontend e CORS
# Em producao, use a URL publica do app web.
FRONTEND_URL=http://127.0.0.1:5173
# Separe multiplas origens por virgula.
# Exemplo: https://app.seudominio.com,https://www.seudominio.com
CORS_ORIGINS=http://127.0.0.1:5173

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-ou-TEST-token

# Use uma URL publica do backend para webhooks em producao.
# Exemplo: https://api.seudominio.com
API_PUBLIC_URL=

# WhatsApp Cloud API / Meta oficial
WHATSAPP_PROVIDER=meta
WHATSAPP_GRAPH_VERSION=v20.0
# Use este endpoint na configuracao de webhooks da Meta.
# Desenvolvimento: exponha o backend com ngrok/cloudflared e use:
# https://sua-url-publica/api/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=crie_um_token_qualquer_e_repita_na_meta
WHATSAPP_APP_SECRET=app_secret_do_app_meta
WHATSAPP_ACCESS_TOKEN=token_permanente_ou_temporario_da_meta
WHATSAPP_PHONE_NUMBER_ID=id_do_numero_no_whatsapp_cloud_api

# Fallback para MVP caso a empresa ainda nao tenha instancia/id do WhatsApp salvo.
WHATSAPP_DEFAULT_EMPRESA_ID=1
